dn: cn=naturalPerson,cn=schema,cn=config
objectClass: olcSchemaConfig
cn: naturalPerson
# -------------------------------------------------------------------
# Attribute Types for RFC 2985 & RFC 3739
# -------------------------------------------------------------------
# Note: If your LDAP server already defines 'emailAddress' or 
# 'pseudonym', you may need to comment out their definitions below 
# to avoid duplicate OID conflicts. 'serialNumber' is omitted here 
# as it is natively provided by the core.schema.
# -------------------------------------------------------------------
#olcAttributeTypes: ( 1.2.840.113549.1.9.1 NAME 'emailAddress' 
# DESC 'RFC 2985: PKCS #9 email address' 
# EQUALITY caseIgnoreIA5Match 
# SUBSTR caseIgnoreIA5SubstringsMatch 
# SYNTAX 1.3.6.1.4.1.1466.115.121.1.26{256} )
olcAttributeTypes: ( 1.2.840.113549.1.9.2 NAME 'unstructuredName' 
 DESC 'RFC 2985: PKCS #9 unstructured name' 
 EQUALITY caseIgnoreMatch 
 SUBSTR caseIgnoreSubstringsMatch 
 SYNTAX 1.3.6.1.4.1.1466.115.121.1.15 )
olcAttributeTypes: ( 1.2.840.113549.1.9.8 NAME 'unstructuredAddress' 
 DESC 'RFC 2985: PKCS #9 unstructured address' 
 EQUALITY caseIgnoreMatch 
 SUBSTR caseIgnoreSubstringsMatch 
 SYNTAX 1.3.6.1.4.1.1466.115.121.1.15 )
olcAttributeTypes: ( 1.3.6.1.5.5.7.9.1 NAME 'dateOfBirth' 
 DESC 'RFC 3739: Date of birth in GeneralizedTime format' 
 EQUALITY generalizedTimeMatch 
 ORDERING generalizedTimeOrderingMatch 
 SYNTAX 1.3.6.1.4.1.1466.115.121.1.24 
 SINGLE-VALUE )
olcAttributeTypes: ( 1.3.6.1.5.5.7.9.2 NAME 'placeOfBirth' 
 DESC 'RFC 3739: Place of birth' 
 EQUALITY caseExactMatch 
 SUBSTR caseExactSubstringsMatch 
 SYNTAX 1.3.6.1.4.1.1466.115.121.1.15 )
olcAttributeTypes: ( 1.3.6.1.5.5.7.9.3 NAME 'gender' 
 DESC 'RFC 3739: Gender (e.g., M, F, m, f)' 
 EQUALITY caseIgnoreMatch 
 SYNTAX 1.3.6.1.4.1.1466.115.121.1.15 
 SINGLE-VALUE )
olcAttributeTypes: ( 1.3.6.1.5.5.7.9.4 NAME 'countryOfCitizenship' 
 DESC 'RFC 3739: Country of citizenship' 
 EQUALITY caseIgnoreMatch 
 SYNTAX 1.3.6.1.4.1.1466.115.121.1.15 )
olcAttributeTypes: ( 1.3.6.1.5.5.7.9.5 NAME 'countryOfResidence' 
 DESC 'RFC 3739: Country of residence' 
 EQUALITY caseIgnoreMatch 
 SYNTAX 1.3.6.1.4.1.1466.115.121.1.15 )
#olcAttributeTypes: ( 2.5.4.65 NAME 'pseudonym' 
# DESC 'X.520: Pseudonym' 
# EQUALITY caseIgnoreMatch 
# SUBSTR caseIgnoreSubstringsMatch 
# SYNTAX 1.3.6.1.4.1.1466.115.121.1.15 )
# -------------------------------------------------------------------
# naturalPerson ObjectClass Definition
# -------------------------------------------------------------------
olcObjectClasses: ( 1.2.840.113549.1.9.24.2 NAME 'naturalPerson' 
 DESC 'RFC 2985: naturalPerson auxiliary object class' 
 SUP top 
 AUXILIARY 
 MAY ( emailAddress $ unstructuredName $ unstructuredAddress $ 
 dateOfBirth $ placeOfBirth $ gender $ countryOfCitizenship $ 
 countryOfResidence $ pseudonym $ serialNumber ) )
